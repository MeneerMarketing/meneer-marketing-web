# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (geen leading slash: ook nested projecten zoals overkapping-gids/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (ook nested apps)
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.env.vercel.*

# typescript
*.tsbuildinfo

# Skin Complete / BestRest themes — aparte repo's, niet de marketing-site
/shopify/
/shopify-theme-bestrest/
/docs/
/_dev-theme-pull/
/_live-check/
/_live-check2/
/_live-check3/

# Lokale dumps van theme-pulls, screenshots, upscale-tools. Blijven op schijf, niet in Git.
.tmp-*/
/documentatie-*.html
/logboek-*
/scripts/patch-homepage*.js
/scripts/strip-checker-bg.mjs
/scripts/em-dash-cleanup.mjs
/scripts/merge-klaviyo-customers.mjs

# Lokale taakbestanden, niet voor GitHub
/tasks/
# Lokaal factuurtool (IBAN, klantgegevens) — nooit mee deployen of pushen
/local/meneer-invoicing/
# Lokale KliniekOS-projecten — nooit mee deployen naar meneermarketing.nl
/kliniekos*/
/kliniekos-*/
# Parked local apps, niet dit GitHub-repo
/overkapping-gids/

.vercel
/bestrest-theme/
