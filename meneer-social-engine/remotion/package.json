{
  "name": "remotion",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.512",
    "@remotion/google-fonts": "^4.0.512",
    "@remotion/tailwind-v4": "4.0.512",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.512",
    "tailwindcss": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.512",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:avatar": "remotion still AvatarCenter ../out/avatars/avatar.png",
    "render:honderd": "remotion render HonderdBezoekers ../out/reels/honderd-bezoekers.mp4",
    "render:de-rekening": "remotion render DeRekening ../out/reels/de-rekening.mp4",
    "render:meneer-fixt": "remotion render MeneerFixt ../out/reels/meneer-fixt.mp4",
    "render:meneer-zegt": "remotion render MeneerZegt ../out/reels/meneer-zegt.mp4",
    "render:reels": "npm run render:honderd && npm run render:de-rekening && npm run render:meneer-fixt && npm run render:meneer-zegt"
  },
  "sideEffects": [
    "*.css"
  ]
}
