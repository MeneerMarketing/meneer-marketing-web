# Publieke site-URL voor metadata en JSON-LD (geen trailing slash)
NEXT_PUBLIC_SITE_URL=https://meneermarketing.nl

# Formulieren → info@meneermarketing.nl (Resend)
# Maak account op https://resend.com en verifieer domein meneermarketing.nl
RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=MeneerMarketing <aanvragen@meneermarketing.nl>
CONTACT_TO_EMAIL=info@meneermarketing.nl

# Optioneel: publieke telefoon/WhatsApp op contact- en werkwijze-pagina
# NEXT_PUBLIC_BUSINESS_PHONE=06 12 34 56 78
# NEXT_PUBLIC_BUSINESS_WHATSAPP=31612345678
# NEXT_PUBLIC_BUSINESS_WHATSAPP_DISPLAY=06 12 34 56 78

# Optioneel: volledig adres voor LocalBusiness schema (straat + postcode)
# NEXT_PUBLIC_BUSINESS_STREET=Straatnaam 1
# NEXT_PUBLIC_BUSINESS_POSTCODE=7311 XX

# Optioneel: Google Search Console verificatie
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/meneermarketing
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/meneermarketing

# Skin Complete — LED Passport foto-upload (shopify → API → e-mail)
# Aparte Resend-key als skincomplete.eu op een ander Resend-account staat dan meneermarketing.nl
SKINCOMPLETE_RESEND_API_KEY=re_xxxxxxxx
SKINCOMPLETE_LED_UPLOAD_TO=office@skincomplete.eu
SKINCOMPLETE_LED_UPLOAD_FROM=Skin Complete <office@skincomplete.eu>
SKINCOMPLETE_LED_RESPONSE_DAYS=5
SKINCOMPLETE_CORS_ORIGINS=https://skincomplete.eu,https://www.skincomplete.eu
